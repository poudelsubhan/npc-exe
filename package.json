{
  "name": "npc-exe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "node --import tsx server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "biome check . && tsc --noEmit && vitest run && node scripts/licenses.mjs && vite build",
    "format": "biome check --write .",
    "tunnel": "node scripts/tunnel.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@pinesandbox/computer": "0.3.3",
    "@pinesandbox/computer-web": "0.3.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "vitest": "^4.0.0"
  }
}
